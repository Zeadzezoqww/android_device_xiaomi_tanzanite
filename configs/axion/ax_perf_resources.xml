<resources>
    <!-- CPU Little Cluster -->
    <resource id="0x0001" name="cpu_little_min" path="/sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq" default="500000" />
    <resource id="0x0002" name="cpu_little_max" path="/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq" default="2000000" />

    <!-- CPU Big Cluster -->
    <resource id="0x0003" name="cpu_big_min" path="/sys/devices/system/cpu/cpu6/cpufreq/scaling_min_freq" default="725000" />
    <resource id="0x0004" name="cpu_big_max" path="/sys/devices/system/cpu/cpu6/cpufreq/scaling_max_freq" default="2200000" />

    <!-- GPU -->
    <resource id="0x0005" name="gpu_opp_index" path="/proc/gpufreqv2/fix_target_opp_index" default="-1" />

    <!-- Memory (DVFSRC) -->
    <resource id="0x0006" name="mem_freq" path="/sys/devices/platform/soc/10012000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq" default="0" />

    <!-- Uclamp (TA) -->
    <resource id="0x0007" name="uclamp_ta_min" path="/dev/cpuctl/top-app/cpu.uclamp.min" default="0" />

    <!-- Thermal SConfig -->
    <resource id="0x0008" name="thermal_sconfig" path="/sys/devices/virtual/thermal/thermal_message/sconfig" default="0" />

    <!-- Task Turbo -->
    <resource id="0x0009" name="task_turbo" path="/sys/module/task_turbo/parameters/feats" default="0" />
</resources>
