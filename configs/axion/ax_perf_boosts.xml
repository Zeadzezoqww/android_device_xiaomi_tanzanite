<boosts>
    <!-- Reusable Boost Groups -->
    <boost-resource id="0x01fd" name="latency_boost">
        <set resource="cpu_little_min" id="0x0001" value="1800000" />
        <set resource="cpu_big_min" id="0x0003" value="2000000" />
        <set resource="uclamp_ta_min" id="0x0007" value="40" />
    </boost-resource>

    <boost-resource id="0x01fe" name="max_perf_boost">
        <set resource="cpu_little_min" id="0x0001" value="2000000" />
        <set resource="cpu_big_min" id="0x0003" value="2200000" />
        <set resource="gpu_opp_index" id="0x0005" value="0" />
        <set resource="uclamp_ta_min" id="0x0007" value="100" />
        <set resource="mem_freq" id="0x0006" value="4266000000" />
    </boost-resource>

    <!-- Boost Hints (android.app.AxBoostFwk opcodes) -->
    <!-- Opcode 1: first_launch / app_launch -->
    <boost opcode="1" timeout_ms="3000" name="app_launch">
        <set resource="max_perf_boost" id="0x01fe" />
    </boost>

    <!-- Opcode 2: scroll -->
    <boost opcode="2" timeout_ms="1000" name="scroll">
        <set resource="latency_boost" id="0x01fd" />
    </boost>

    <!-- Opcode 3: fling -->
    <boost opcode="3" timeout_ms="1500" name="fling">
        <set resource="latency_boost" id="0x01fd" />
    </boost>

    <!-- Opcode 6: rotation -->
    <boost opcode="6" timeout_ms="1000" name="rotation">
        <set resource="latency_boost" id="0x01fd" />
    </boost>

    <!-- Opcode 10: camera_launch -->
    <boost opcode="10" timeout_ms="5000" name="camera_launch">
        <set resource="max_perf_boost" id="0x01fe" />
    </boost>

    <!-- Opcode 14: game -->
    <boost opcode="14" timeout_ms="0" name="game">
        <set resource="cpu_little_min" id="0x0001" value="1600000" />
        <set resource="cpu_big_min" id="0x0003" value="2000000" />
        <set resource="gpu_opp_index" id="0x0005" value="5" />
        <set resource="thermal_sconfig" id="0x0008" value="10" />
    </boost>
</boosts>
