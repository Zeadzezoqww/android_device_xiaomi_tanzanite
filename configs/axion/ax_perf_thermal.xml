<perf-config>
    <atmc>
        <cpu_levels>
            <!-- MT6789: Little (0-5), Big (6-7) -->
            <level status="0" little="2000000" big="2200000" />
            <level status="1" little="1800000" big="1800000" />
            <level status="2" little="1400000" big="1400000" />
        </cpu_levels>

        <gpu_levels>
            <!-- OPP Indices -->
            <level status="0" index="-1" />
            <level status="1" index="10" />
            <level status="2" index="20" />
        </gpu_levels>

        <boost_scenarios>
            <!-- Map thermal levels to boost actions -->
            <scenario name="normal" status="0" boost="true" />
            <scenario name="moderate" status="1" boost="true" />
            <scenario name="severe" status="2" boost="false" />
        </boost_scenarios>
    </atmc>
</perf-config>
