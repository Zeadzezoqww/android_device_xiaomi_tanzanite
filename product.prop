# Animation
persist.sys.activity_anim_perf_override=true

# FM Radio
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.noise_floor_detect=true
ro.fm.fake_chans=4
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205

# GPU Enhancement Driver (GED)
sys.vendor.ged.gpu_boost=1

# Performance Hub
persist.vendor.power.fixed_performance_scale=0
ro.vendor.mtk_perf_fast_response=1
ro.vendor.mtk_perf_simple_start_win=1

# Memory Management
ro.config.low_ram=false
ro.lmk.kill_heaviest_task=false

# Graphics & Rendering
debug.sf.disable_backpressure=1
debug.sf.latch_unsignaled=1

# Scrolling Optimizations
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1
