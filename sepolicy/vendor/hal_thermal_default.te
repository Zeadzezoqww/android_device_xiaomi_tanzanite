# 1. Register as a Thermal HAL server
hal_server_domain(hal_thermal_default, hal_thermal)

# 2. Keep the sysfs access (this is what it actually needs)
allow hal_thermal_default sysfs_thermal:dir r_dir_perms;
allow hal_thermal_default sysfs_thermal:file rw_file_perms;
allow hal_thermal_default sysfs_thermal:lnk_file r_file_perms;

# 3. Add necessary binder call for hwservicemanager
binder_call(hal_thermal_default, hwservicemanager)
binder_call(hwservicemanager, hal_thermal_default)

# 4. REMOVE the proc_sched/proc_dirty rules for now 
# If it needs these, it will trigger an AVC denial in dmesg. 
# Don't add them until you see the specific "avc: denied" log for them.

allow hal_thermal_default vendor_thermal_config_file:file r_file_perms;
